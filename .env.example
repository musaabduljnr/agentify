# ==============================================================================
# AGENTIFY — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# SECURITY RULES:
# 1. Variables prefixed with NEXT_PUBLIC_ are bundled into the client.
#    ONLY public keys, URLs, and non-sensitive identifiers should use this prefix.
# 2. Variables WITHOUT this prefix are SERVER-ONLY and safe from client exposure.
# 3. NEVER commit .env.local to version control.
# 4. Never expose API keys or secrets in code or commits.
# ==============================================================================

# ==============================================================================
# SUPABASE (Database & Auth)
# ==============================================================================
# Your Supabase project URL (found in Supabase Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase anonymous key (safe to expose to client)
# Used for read operations and Row Level Security (RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here

# Supabase service role key (Server-side only — DO NOT EXPOSE TO CLIENT)
# Used for webhooks, administrative tasks, and background jobs
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Base URL of your deployed application
APP_URL=https://agentifychat.online
NEXT_PUBLIC_APP_URL=https://agentifychat.online

# ==============================================================================
# WEBHOOK WORKER (scheduled delivery)
# ==============================================================================
# Shared bearer token for the scheduled worker. Set the same value in Vercel
# Production and as a GitHub Actions repository secret named CRON_SECRET.
CRON_SECRET=generate_a_long_random_value

# ==============================================================================
# LEGAL / COMPANY IDENTITY (used in footer, terms, privacy and email footers)
# ==============================================================================
# Use your actual registered legal entity name.
NEXT_PUBLIC_COMPANY_LEGAL_NAME=Agentify
# CAN-SPAM requires a physical postal address in commercial emails.
NEXT_PUBLIC_COMPANY_POSTAL_ADDRESS=Your registered postal address
SUPPORT_EMAIL=support@agentifychat.online
SALES_EMAIL=sales@agentifychat.online

# ==============================================================================
# ANALYTICS & ADS (Meta Pixel + Google tag)
# ==============================================================================
# Leave blank to disable the corresponding script.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_TAG_ID=

# ==============================================================================
# BACHS (USD-Only Recurring Subscriptions & Hosted Checkout)
# ==============================================================================
# Secret API key from Bachs Developer Portal (sk_sandbox_... or sk_live_...)
# DO NOT EXPOSE TO CLIENT
BACHS_API_KEY=sk_sandbox_8033dcec_M4Xg_nVpFJGicokBiVANt-wvm1GLzV_YckSsW_4jdlA

# Base API URL:
# Sandbox: https://sandbox-api.bachs.io
# Production: https://api.bachs.io
BACHS_API_URL=https://sandbox-api.bachs.io

# Webhook signing secret (whsec_...) for validating X-Bachs-Signature-V2
BACHS_WEBHOOK_SECRET=whsec_bdb4284e3a8f21c8be2b9a11ce6647b147d1c287a48f0a0b4eb324ddc1b00bc0

# Recurring Product IDs created in Bachs (monthly billing, USD card payments)
# Generated via `npm run bachs:setup` or Bachs Dashboard > Products
BACHS_STARTER_PRODUCT_ID=prod_starter_product_id_here
BACHS_GROWTH_PRODUCT_ID=prod_growth_product_id_here

# ==============================================================================
# UPSTASH REDIS (Rate Limiting & Caching)
# ==============================================================================
# REST API URL and token from https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# ==============================================================================
# GOOGLE GEMINI API (Server-side only — DO NOT EXPOSE TO CLIENT)
# ==============================================================================
# Get your API key from: https://aistudio.google.com/app/apikey
# This key should ONLY be used server-side (API routes, Edge Functions)
GOOGLE_GENAI_API_KEY=your_google_gemini_api_key_here

# ==============================================================================
# RESEND EMAIL SERVICE (Server-side only — DO NOT EXPOSE TO CLIENT)
# ==============================================================================
# Get your API key from: https://resend.com/dashboard
# Used for sending automated emails and campaigns
RESEND_API_KEY=your_resend_api_key_here

# ==============================================================================
# APPLICATION ENVIRONMENT
# ==============================================================================
# Set to: development, staging, or production
NODE_ENV=development

# ==============================================================================
# OPTIONAL: AI & CONTENT SETTINGS
# ==============================================================================
# Controls behavior of AI responses (temperature: 0 = deterministic, 1 = creative)
# NEXT_PUBLIC_AI_TEMPERATURE=0.7

# Controls maximum tokens in AI responses (higher = longer responses)
# NEXT_PUBLIC_MAX_TOKENS=1024

# ==============================================================================
# DEVELOPMENT TIPS
# ==============================================================================
# 1. Create .env.local by copying this file
# 2. Fill in your actual credentials
# 3. For Supabase keys:
#    - Go to Supabase Dashboard
#    - Select your project
#    - Settings > API
#    - Copy "Project URL" and "anon public" key
# 4. For Gemini API:
#    - Go to https://aistudio.google.com/app/apikey
#    - Create or copy your API key
# 5. For Resend:
#    - Go to https://resend.com/dashboard
#    - Copy your API key from the home screen
# 6. Never share these keys publicly
# 7. Rotate keys periodically
# ==============================================================================


8139699320 moniepoint